# CampusConnect AI - Environment Variables
# Copy this file to .env.local for local overrides.
# If these variables are left unset or default, CampusConnect AI automatically
# operates in full interactive offline Demo Mode with LocalStorage state persistence.

# Supabase PostgreSQL & Auth configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Server-side LLM endpoint or key (used strictly in backend functions, NEVER exposed in client bundle)
# VITE_AI_PROVIDER=openai
